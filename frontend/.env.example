# Frontend Environment Variables
# Variables prefixed with VITE_ are exposed to the browser

# Backend API URL (used by Axios in the browser)
# In dev: use /api (proxied by Vite to backend)
# In prod: use full URL like https://api.yourdomain.com/api
VITE_API_URL=/api

# Backend server URL (used by Vite dev proxy only - NOT exposed to browser)
VITE_BACKEND_URL=http://localhost:5000

# Vite dev server port
VITE_PORT=5173

# App display name
VITE_APP_NAME=EduAI Assistant 2.0
