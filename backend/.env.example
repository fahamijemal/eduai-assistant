# Backend Environment Variables

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/eduai

# JWT
JWT_SECRET=your-secret-key-change-this
JWT_EXPIRES_IN=7d

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# File uploads
UPLOAD_DIR=./uploads

# AI Quota (per user)
AI_QUOTA_PER_USER=100
